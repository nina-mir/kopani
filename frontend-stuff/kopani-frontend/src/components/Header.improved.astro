---
const navItems = [
  { label: "Essays", href: "/essays" },
  { label: "Fiction", href: "/fiction" },
  { label: "Poetry", href: "/poetry" },
  { label: "Interviews", href: "/interviews" },
  { label: "Art", href: "/art" },
];

const utilityItems = [
  { label: "For Campuses", href: "/campuses" },
  { label: "Support a Writer", href: "/support" },
];
---

{/*
  TWO-LAYER FOLDING HEADER

  Layer 1 — .masthead: ordinary in-flow content. NOT sticky. It scrolls
  away with the page (only a soft opacity fade as a flourish). Because it
  never animates its own height while pinned, it can't lurch the page.

  Layer 2 — .bar: position:fixed, height LOCKED to --bar-h. Being fixed,
  it's out of document flow, so revealing it costs zero layout. It hides
  via transform + opacity only (compositor-cheap → smooth).

  An IntersectionObserver watches #header-sentinel (the 1px marker at the
  end of the masthead). The bar shows exactly when that marker leaves the
  top of the viewport. No scroll math, no thresholds, no oscillation.
*/}

<!-- LAYER 1 — masthead -->
<header class="masthead" data-masthead>
  <!-- mobile only: hamburger, visible even at the top (opens the drawer) -->
  <button
    class="masthead__hamburger"
    aria-label="Open menu"
    aria-expanded="false"
    data-open-drawer
  >
    <span></span><span></span><span></span>
  </button>

  <a href="/" class="masthead__home">
    <h1 class="masthead__logo">Kopani</h1>
  </a>

  <!-- mobile only: balances the 44px hamburger so the logo stays centred -->
  <span class="masthead__spacer" aria-hidden="true"></span>

  <p class="masthead__byline">The independent literary press, gathered.</p>

  <nav class="masthead__nav" aria-label="Primary">
    <ul>
      {
        navItems.map((item, i) => (
          <li class="masthead__nav-item">
            <a href={item.href}>{item.label}</a>
            {i < navItems.length - 1 && <span class="masthead__sep">|</span>}
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<!-- the marker the observer watches -->
<div id="header-sentinel" aria-hidden="true"></div>

<!-- LAYER 2 — pinned bar -->
<div class="bar" data-bar>
  <button
    id="nav-toggle"
    class="bar__hamburger"
    aria-label="Open menu"
    aria-expanded="false"
    data-open-drawer
  >
    <span></span><span></span><span></span>
  </button>

  <a href="/" class="bar__logo">Kopani</a>

  <form action="/search" method="get" role="search" class="bar__search">
    <label for="global-search-desktop" class="sr-only">Search Kopani</label>
    <input
      id="global-search-desktop"
      name="q"
      type="search"
      autocomplete="off"
      placeholder="Search Kopani"
    />
    <button type="submit" aria-label="Search">↗</button>
  </form>
</div>

<!-- drawer backdrop -->
<div id="nav-backdrop" data-backdrop aria-hidden="true"></div>

<!-- drawer -->
<aside id="nav-drawer" class="drawer" aria-label="Site navigation">
  <div class="drawer__top">
    <span class="drawer__wordmark">Kopani</span>
    <button id="nav-close" class="drawer__close" aria-label="Close menu" data-close-drawer>×</button>
  </div>

  <form action="/search" method="get" role="search" class="drawer__search">
    <label for="global-search-mobile" class="drawer__label">Search Kopani</label>
    <div class="drawer__search-box">
      <input
        id="global-search-mobile"
        name="q"
        type="search"
        autocomplete="off"
        placeholder="Title, author, journal..."
      />
      <button type="submit" aria-label="Search">↗</button>
    </div>
  </form>

  <p class="drawer__label drawer__label--mt">Browse</p>
  <ul class="drawer__list">
    {navItems.map((item) => (
      <li><a href={item.href}>{item.label}</a></li>
    ))}
  </ul>

  <p class="drawer__label drawer__label--mt">Kopani</p>
  <ul class="drawer__list">
    {utilityItems.map((item) => (
      <li><a href={item.href}>{item.label}</a></li>
    ))}
  </ul>

  <p class="drawer__footnote">Read what the small presses are printing.</p>
</aside>

<script>
  // ONE source of truth: is the sentinel (end of masthead) on screen?
  // The observer fires only when that answer flips — so there is no
  // scroll-listener math and no oscillation possible.
  const bar = document.querySelector<HTMLElement>("[data-bar]");
  const masthead = document.querySelector<HTMLElement>("[data-masthead]");
  const sentinel = document.getElementById("header-sentinel");

  if (bar && masthead && sentinel) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        const mastheadGone = !entry.isIntersecting;
        bar.classList.toggle("is-visible", mastheadGone);
        masthead.classList.toggle("is-gone", mastheadGone);
      },
      { rootMargin: "-8px 0px 0px 0px", threshold: 0 }
    );
    observer.observe(sentinel);
  }

  // Drawer wiring. There are now two triggers — the mobile masthead
  // hamburger and the pinned-bar hamburger — so select all of them.
  const drawer = document.getElementById("nav-drawer");
  const backdrop = document.querySelector<HTMLElement>("[data-backdrop]");
  const openBtns = document.querySelectorAll<HTMLElement>("[data-open-drawer]");
  const closeBtn = document.querySelector<HTMLElement>("[data-close-drawer]");

  const open = () => {
    drawer?.classList.add("is-open");
    backdrop?.classList.add("is-open");
    openBtns.forEach((btn) => btn.setAttribute("aria-expanded", "true"));
    document.body.style.overflow = "hidden";
  };

  const close = () => {
    drawer?.classList.remove("is-open");
    backdrop?.classList.remove("is-open");
    openBtns.forEach((btn) => btn.setAttribute("aria-expanded", "false"));
    document.body.style.overflow = "";
  };

  openBtns.forEach((btn) => btn.addEventListener("click", open));
  closeBtn?.addEventListener("click", close);
  backdrop?.addEventListener("click", close);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") close();
  });
</script>

<style>
  /*
    The ONE height that matters. The pinned bar is locked to this and
    never changes — that is what removes the lurch.
  */
  :root {
    --bar-h: 66px;
  }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0);
    white-space: nowrap; border: 0;
  }

  /* ===== LAYER 1 — MASTHEAD (in flow, scrolls away) =====
     MOBILE  : compact app-style row — [hamburger] [centred logo] [spacer],
               byline beneath. The full nav lives in the drawer.
     DESKTOP (>=768px): grand centred masthead — big logo, byline, and the
               inline nav row. Hamburger + spacer are hidden.
  */
  .masthead {
    display: grid;
    grid-template-columns: 44px 1fr 44px;
    align-items: center;
    row-gap: 0.4rem;
    padding: 0.85rem 1rem;
    background-color: var(--color-cream, #f4ecdd);
    border-bottom: 3px double var(--color-ink);
    transition: opacity 0.35s ease;
  }
  .masthead.is-gone {
    opacity: 0;
  }

  .masthead__hamburger {
    grid-column: 1;
    grid-row: 1;
    justify-self: start;
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 8px;
  }
  .masthead__hamburger span {
    display: block;
    height: 2px;
    width: 22px;
    background: color-mix(in srgb, var(--color-ink) 75%, transparent);
  }

  .masthead__home {
    grid-column: 2;
    grid-row: 1;
    justify-self: center;
    text-align: center;
    text-decoration: none;
    color: inherit;
  }
  .masthead__logo {
    font-family: var(--font-secret-service);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -0.01em;
    color: color-mix(in srgb, var(--color-ink) 92%, transparent);
    font-size: 2.6rem;
    margin: 0;
  }

  .masthead__spacer {
    grid-column: 3;
    grid-row: 1;
    width: 44px;
  }

  .masthead__byline {
    grid-column: 1 / -1;
    grid-row: 2;
    text-align: center;
    font-family: var(--font-arno);
    font-style: italic;
    color: var(--color-ochre);
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    margin: 0;
  }

  .masthead__nav {
    display: none;
  }

  @media (min-width: 768px) {
    .masthead {
      display: block;
      text-align: center;
      padding: 2.6rem 1rem 0;
    }
    .masthead__hamburger,
    .masthead__spacer {
      display: none;
    }
    .masthead__logo {
      font-size: clamp(2.75rem, 7vw, 5rem);
    }
    .masthead__byline {
      font-size: 1rem;
      margin: 0.65rem 0 0;
    }
    .masthead__nav {
      display: block;
      margin-top: 1.4rem;
      border-top: 1px solid var(--color-cream-dark);
      padding: 0.8rem 0;
    }
    .masthead__nav ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      justify-content: center;
      align-items: center;
      font-family: var(--font-body);
      text-transform: uppercase;
      letter-spacing: 0.18em;
      font-size: 0.82rem;
      color: var(--color-ink);
    }
    .masthead__nav-item {
      display: flex;
      align-items: center;
    }
    .masthead__nav a {
      padding: 0 1rem;
      text-decoration: none;
      color: inherit;
    }
    .masthead__nav a:hover {
      color: var(--color-prussian);
    }
    .masthead__sep {
      color: var(--color-cream-dark);
    }
  }

  #header-sentinel {
    height: 1px;
  }

  /* ===== LAYER 2 — PINNED BAR (fixed, constant height) ===== */
  .bar {
    position: fixed;
    inset: 0 0 auto 0;
    height: var(--bar-h);
    z-index: 50;
    display: grid;
    grid-template-columns: 44px 1fr 44px;
    align-items: center;
    padding: 0 1rem;
    background-color: color-mix(in srgb, var(--color-cream, #f4ecdd) 25%, transparent);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border-bottom: 3px double var(--color-ink);

    transform: translateY(-100%);
    opacity: 0;
    pointer-events: none;
    transition:
      transform 0.32s cubic-bezier(0.22, 0.61, 0.36, 1),
      opacity 0.32s ease;
    will-change: transform;
  }
  .bar.is-visible {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .bar__logo {
    grid-column: 2;
    justify-self: center;
    font-family: var(--font-secret-service);
    font-size: 1.7rem;
    line-height: 1;
    text-decoration: none;
    color: color-mix(in srgb, var(--color-ink) 92%, transparent);
  }

  .bar__hamburger {
    grid-column: 1;
    justify-self: start;
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 8px;
  }
  .bar__hamburger span {
    display: block;
    height: 2px;
    width: 22px;
    background: color-mix(in srgb, var(--color-ink) 75%, transparent);
  }

  .bar__search {
    grid-column: 3;
    justify-self: end;
    display: none;
    align-items: center;
    border: 1px solid color-mix(in srgb, var(--color-ink) 20%, transparent);
    background: color-mix(in srgb, var(--color-linen) 70%, transparent);
    box-shadow: 2px 2px 0 rgba(28, 18, 8, 0.08);
  }
  .bar__search input {
    border: 0;
    background: transparent;
    outline: none;
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-ink);
    padding: 0.45rem 0.6rem;
    width: 150px;
    min-width: 0;
  }
  .bar__search input::placeholder {
    font-style: italic;
    color: color-mix(in srgb, var(--color-umber) 45%, transparent);
  }
  .bar__search button {
    border: 0;
    border-left: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent);
    background: transparent;
    padding: 0 0.7rem;
    align-self: stretch;
    font-family: var(--font-mono);
    color: var(--color-umber);
    cursor: pointer;
  }
  .bar__search button:hover {
    background: var(--color-ink);
    color: var(--color-linen);
  }

  @media (min-width: 768px) {
    .bar {
      grid-template-columns: 1fr auto 1fr;
      padding: 0 2.5rem;
    }
    .bar__search {
      display: flex;
      width: 320px;
    }
    .bar__search input {
      width: 100%;
      flex: 1;
    }
  }

  /* ===== DRAWER ===== */
  #nav-backdrop {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: rgba(28, 18, 8, 0.55);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  #nav-backdrop.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .drawer {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 70;
    height: 100%;
    width: 85vw;
    max-width: 360px;
    background: var(--color-linen);
    padding: 1.5rem;
    transform: translateX(-100%);
    transition: transform 0.3s ease-out;
    overflow-y: auto;
  }
  .drawer.is-open {
    transform: translateX(0);
  }
  .drawer__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    border-bottom: 2px solid var(--color-umber);
    padding-bottom: 1rem;
  }
  .drawer__wordmark {
    font-family: var(--font-secret-service);
    font-size: 1.8rem;
    line-height: 1;
    color: color-mix(in srgb, var(--color-ink) 90%, transparent);
  }
  .drawer__close {
    background: none;
    border: 0;
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1;
    color: var(--color-ink);
    cursor: pointer;
  }

  .drawer__search {
    margin-top: 1.5rem;
  }
  .drawer__label {
    display: block;
    font-family: var(--font-body);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-brick);
  }
  .drawer__label--mt {
    margin-top: 2rem;
  }
  .drawer__search-box {
    margin-top: 0.75rem;
    display: flex;
    align-items: center;
    border: 1px solid color-mix(in srgb, var(--color-ink) 20%, transparent);
    background: color-mix(in srgb, var(--color-linen) 80%, transparent);
    box-shadow: 2px 2px 0 rgba(28, 18, 8, 0.08);
  }
  .drawer__search-box input {
    border: 0;
    background: transparent;
    outline: none;
    flex: 1;
    min-width: 0;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-ink);
    padding: 0.6rem 0.7rem;
  }
  .drawer__search-box input::placeholder {
    font-style: italic;
    color: color-mix(in srgb, var(--color-umber) 45%, transparent);
  }
  .drawer__search-box button {
    border: 0;
    border-left: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent);
    background: transparent;
    padding: 0 0.9rem;
    align-self: stretch;
    font-family: var(--font-mono);
    color: var(--color-umber);
    cursor: pointer;
  }
  .drawer__search-box button:hover {
    background: var(--color-ink);
    color: var(--color-linen);
  }

  .drawer__list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 300;
  }
  .drawer__list li {
    margin-bottom: 0.65rem;
  }
  .drawer__list a {
    color: var(--color-ink);
    text-decoration: none;
  }
  .drawer__list a:hover {
    color: var(--color-prussian);
  }
  .drawer__footnote {
    margin-top: 2.5rem;
    font-family: var(--font-body);
    font-style: italic;
    font-size: 0.9rem;
    color: var(--color-umber);
  }

  @media (prefers-reduced-motion: reduce) {
    .masthead,
    .bar,
    .drawer,
    #nav-backdrop {
      transition: none;
    }
  }
</style>