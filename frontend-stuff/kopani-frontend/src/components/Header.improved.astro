---
const navItems = [
  { label: "Essays", href: "/essays" },
  { label: "Fiction", href: "/fiction" },
  { label: "Poetry", href: "/poetry" },
  { label: "Interviews", href: "/interviews" },
  { label: "Art", href: "/art" },
  { label: "Translation", href: "/translation" },
  { label: "Reviews", href: "/reviews" },
];
---

<header class="border-b-[3px] border-double border-ink">
  <div
    class="grid grid-cols-[44px_1fr_44px] items-center px-4 py-4 md:grid-cols-[1fr_auto_1fr] md:px-10 md:py-6"
  >
    <!-- Left: hamburger on mobile, desktop search on larger screens -->
    <div class="justify-self-start self-center">
      <button
        id="nav-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        class="flex flex-col gap-1.5 p-2 md:hidden"
      >
        <span class="block h-[2px] w-[22px] bg-ink/80"></span>
        <span class="block h-[2px] w-[22px] bg-ink/75"></span>
        <span class="block h-[2px] w-[22px] bg-ink/70"></span>
      </button>

      <!-- Desktop global search.
           This is intentionally a normal GET form:
           typing "memory" submits to /search?q=memory.
      -->
    </div>

    <!-- Center: logo -->
    <a href="/" class="min-w-0 justify-self-center text-center">
      <h1
        class="font-secret-service leading-none tracking-tight text-ink/90"
        style="font-size: clamp(2.75rem, 7vw, 5rem);"
      >
        Kopani
      </h1>

      <!-- Desktop subtitle -->
      <p
        class="mt-2 hidden font-arno italic font-normal text-ochre md:block md:text-[1rem] md:tracking-[0.06em]"
      >
        The independent literary press, gathered.
      </p>
    </a>

    <!-- Right: spacer on mobile, utility links on desktop -->
    <div class="justify-self-end self-center">
      <div class="w-[44px] md:hidden"></div>

      <!-- <nav class="hidden gap-5 font-body text-sm text-umber md:flex">
        <a href="/rss" class="hover:text-prussian">RSS</a>
        <a href="/submit" class="hover:text-prussian">Submit</a>
      </nav> -->
        <form
        action="/search"
        method="get"
        role="search"
        class="hidden w-[260px] md:block lg:w-[320px]"
      >
        <label for="global-search-desktop" class="sr-only">Search Kopani</label>

        <div
          class="flex items-center border border-ink/20 bg-linen/70 shadow-[2px_2px_0_rgba(28,18,8,0.08)] transition focus-within:border-prussian"
        >
          <input
            id="global-search-desktop"
            name="q"
            type="search"
            autocomplete="off"
            placeholder="Search Kopani"
            class="min-w-0 flex-1 bg-transparent px-3 py-2 font-body text-sm text-ink outline-none placeholder:text-umber/45"
          />

          <button
            type="submit"
            class="border-l border-ink/15 px-3 py-2 font-body text-xs uppercase tracking-[0.16em] text-umber transition hover:bg-ink hover:text-linen"
          >
            Go
          </button>
        </div>
      </form>
    
    </div>

    <!-- Mobile subtitle -->
    <p
      class="col-span-3 mt-2 whitespace-nowrap text-center font-arno text-[1rem] font-normal italic text-ochre md:hidden"
    >
      The independent literary press, gathered.
    </p>
  </div>
</header>

<!-- Primary nav (desktop only) -->
<nav class="hidden border-t border-cream-dark py-3 md:block">
  <ul
    class="flex justify-center font-body text-sm uppercase tracking-[0.18em] text-ink"
  >
    {
      navItems.map((item, i) => (
        <li class="flex items-center">
          <a href={item.href} class="px-4 hover:text-prussian">
            {item.label}
          </a>
          {i < navItems.length - 1 && <span class="text-cream-dark">|</span>}
        </li>
      ))
    }
  </ul>
</nav>

<!-- Mobile drawer -->
<div
  id="nav-backdrop"
  class="fixed inset-0 z-40 hidden md:hidden"
  style="background-color: rgba(28, 18, 8, 0.55);"
  aria-hidden="true"
>
</div>

<aside
  id="nav-drawer"
  class="fixed left-0 top-0 z-50 h-full w-[85vw] max-w-[340px] -translate-x-full bg-linen p-6 transition-transform duration-300 ease-out md:hidden"
  aria-label="Site navigation"
>
  <div class="flex items-start justify-between border-b-2 border-umber pb-4">
    <span class="font-display text-3xl font-light text-ink">Kopani</span>
    <button
      id="nav-close"
      aria-label="Close menu"
      class="font-display text-3xl leading-none text-ink"
    >
      ×
    </button>
  </div>

  <!-- Mobile global search.
       It does the same thing as desktop search:
       submit to /search?q=...
  -->
  <form action="/search" method="get" role="search" class="mt-6">
    <label
      for="global-search-mobile"
      class="block font-body text-xs uppercase tracking-[0.2em] text-brick"
    >
      Search Kopani
    </label>

    <div
      class="mt-3 flex items-center border border-ink/20 bg-linen/80 shadow-[2px_2px_0_rgba(28,18,8,0.08)] focus-within:border-prussian"
    >
      <input
        id="global-search-mobile"
        name="q"
        type="search"
        autocomplete="off"
        placeholder="Title, author, journal..."
        class="min-w-0 flex-1 bg-transparent px-3 py-3 font-body text-base text-ink outline-none placeholder:text-umber/45"
      />

      <button
        type="submit"
        class="border-l border-ink/15 px-3 py-3 font-body text-xs uppercase tracking-[0.16em] text-umber hover:bg-ink hover:text-linen"
      >
        Go
      </button>
    </div>
  </form>

  <p class="mt-8 font-body text-xs uppercase tracking-[0.2em] text-brick">
    Browse
  </p>

  <ul class="mt-4 space-y-3 font-display text-2xl font-light">
    {
      navItems.map((item) => (
        <li>
          <a href={item.href} class="block text-ink hover:text-prussian">
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>

  <p
    class="absolute bottom-6 left-6 right-6 font-body text-sm italic text-umber"
  >
    Read what the small presses are printing.
  </p>
</aside>

<script>
  const toggle = document.getElementById("nav-toggle");
  const drawer = document.getElementById("nav-drawer");
  const backdrop = document.getElementById("nav-backdrop");
  const closeBtn = document.getElementById("nav-close");

  const open = () => {
    drawer?.classList.remove("-translate-x-full");
    backdrop?.classList.remove("hidden");
    toggle?.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
  };

  const close = () => {
    drawer?.classList.add("-translate-x-full");
    backdrop?.classList.add("hidden");
    toggle?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  };

  toggle?.addEventListener("click", open);
  closeBtn?.addEventListener("click", close);
  backdrop?.addEventListener("click", close);

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") close();
  });
</script>