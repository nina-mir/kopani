---
/**
 * Kopani editorial card
 *
 * Temporary approach: this component can render either:
 * 1. explicit props passed from a parent page, or
 * 2. the `placeholderPiece` below while SQLite is not integrated yet.
 *
 * Future DB mapping:
 * - piece.title                 -> title
 * - piece.subtitle              -> subtitle
 * - piece.summary ?? meta_description -> dek
 * - piece.content_type          -> contentType
 * - piece.publication_date_display ?? publication_date -> dateLabel
 * - piece.read_time_minutes     -> readTimeMinutes
 * - piece.word_count_estimate   -> wordCountEstimate
 * - piece.image_url             -> imageUrl     // use Kopani-owned images only
 * - piece.source_image_url      -> avoid display unless rights are confirmed
 * - journals.name               -> journalName
 * - journals.homepage_url       -> journalUrl
 * - authors via piece_contributors(role='author')      -> authors
 * - authors via piece_contributors(role='translator')  -> translators
 * - authors via piece_contributors(role='visual_artist')-> visualArtists
 * - pieces.ai_keywords_json     -> aiKeywords
 */
import { getCardTextureClass } from "../lib/cardVariants";
import {
  getReadTimeGaugeLabel,
  getReadTimeGaugePercent,
  shouldUseReadTimeGauge,
} from "../lib/cardVariants";

import {
  getSpineVariant,
  shouldUseSpineArtifact
} from "../lib/cardVariants";

type Contributor = {
  name: string;
  href?: string;
};

type PieceCard = {
  title: string;
  subtitle?: string;
  dek?: string;
  contentType: string;
  href: string;
  journalName: string;
  journalUrl: string;
  originalUrl: string;
  authors: Contributor[];
  translators?: Contributor[];
  visualArtists?: Contributor[];
  dateLabel?: string;
  issueLabel?: string;
  readTimeMinutes?: number;
  wordCountEstimate?: number;
  imageUrl?: string;
  aiKeywords?: string[];
  featured?: boolean;
};

// interface Props extends Partial<PieceCard> {
//   piece?: PieceCard;
// }

interface Props extends Partial<PieceCard> {
  piece?: PieceCard;
  index?: number;
}

const placeholderPiece: PieceCard = {
  title: "The Cartographer's Silence",
  subtitle: "after a map found in a borrowed book",
  dek: "A spare, luminous essay about memory, weather, and the coordinates we inherit from other people's stories.",
  contentType: "Essay",
  href: "/journals/evergreen-review/the-cartographers-silence",
  journalName: "Evergreen Review",
  journalUrl: "https://www.evergreenreview.com/",
  authors: [{ name: "Mara Iqbal", href: "/authors/mara-iqbal" }],
  translators: [{ name: "Jonas Reed" }],
  visualArtists: [{ name: "Lina Park" }],
  dateLabel: "Spring 2019",
  issueLabel: "Issue 42",
  readTimeMinutes: 7,
  wordCountEstimate: 1850,
  aiKeywords: ["memory", "maps", "inheritance"],
  featured: true,
};

const piece: PieceCard = {
  ...placeholderPiece,
  ...Astro.props.piece,
  ...Astro.props,
};

const {
  title,
  subtitle,
  dek,
  contentType,
  href,
  originalUrl,
  journalName,
  journalUrl,
  authors,
  translators = [],
  visualArtists = [],
  dateLabel,
  issueLabel,
  readTimeMinutes,
  wordCountEstimate,
  imageUrl,
  aiKeywords = [],
  featured = false,
} = piece;

const textureClass = getCardTextureClass(contentType);
const index = Astro.props.index;

const byline = authors.map((author) => author.name).join(", ");
const metaItems = [
  dateLabel,
  issueLabel,
].filter(Boolean);

const useReadTimeGauge =
  shouldUseReadTimeGauge(index) && Boolean(readTimeMinutes);

const readTimeGaugePercent = getReadTimeGaugePercent(readTimeMinutes);
const readTimeGaugeLabel = getReadTimeGaugeLabel(readTimeMinutes);

const useSpineArtifact = shouldUseSpineArtifact(index);
const spineVariant = getSpineVariant(contentType, issueLabel, dateLabel);

const visibleKeywords = aiKeywords.slice(0, 10);
const wordCountLabel = wordCountEstimate
  ? `${wordCountEstimate.toLocaleString()} words`
  : undefined;
---
<article
  class:list={[
    "group flex min-h-[92vh] flex-col overflow-hidden border border-ink/10 bg-linen shadow-[0_1px_0_rgba(28,18,8,0.06)] md:aspect-[4/8] md:min-h-0",
    useSpineArtifact && spineVariant.cardClass,
  ]}
>
{
  useSpineArtifact && (
    <>
      <div class={spineVariant.spineClass} aria-hidden="true">
        <span class="kopani-card-spine__label">
          {spineVariant.spineLabel}
        </span>
      </div>

      <div class="kopani-card-tab" aria-hidden="true">
        {spineVariant.tabLabel}
      </div>
    </>
  )
}
  <!--
        Desktop ratio experiment.
        Change this freely.

        Examples:
        md:aspect-[4/5]
        md:aspect-[3/4]
        md:aspect-[5/6]
    -->

  <!--
    TOP VISUAL AREA

    The image area intentionally occupies roughly half the card.
    The title and featured badge live ON the image.
  -->
  <div class="relative h-1/2 overflow-hidden">
    <a href={href} class="absolute inset-0 block">
      {
        imageUrl ? (
          <img
            src={imageUrl}
            alt=""
            loading="lazy"
            class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.02]"
          />
        ) : (
          <!--
            Editorial fallback texture.
            Keeping this because it fits Kopani very well.
          -->
          <div class={textureClass} aria-hidden="true" />
        )
      }

      <!-- subtle readability wash -->
      <div class="absolute inset-0 bg-linear-to-t from-ink/95 via-ink/20 to-transparent"></div>
        <!-- NEW: top scrim — mirrors the bottom, supports the kicker + journal name -->
      <div class="absolute inset-x-0 top-0 h-2/5 bg-linear-to-b from-ink/65 via-ink/15 to-transparent"></div>
    </a>

    <!-- FEATURED BADGE -->
    {
      featured && (
        <div class="absolute left-4 top-4 z-10">
          <span
            class="
              bg-brick
              px-3
              py-1
              text-[0.65rem]
              uppercase
              tracking-[0.22em]
              text-linen
              font-acumin
            "
          >
            Featured
          </span>
        </div>
      )
    }
    
    <!-- CONTENT TYPE -->

    { 
      contentType &&  (
        <div class="kopani-card-top-labels absolute left-4 top-10 z-10">        
          <p
          class="
            font-acumin
            text-[0.88rem]
            uppercase
            tracking-[0.62em]
            text-umber
            font-bold
          "
        >
          {contentType}
        </p>
      </div>
      )
    }


    <div class="absolute right-4 top-4 z-10">
    <!--         
          IMPORTANT:
          Kopani links OUT to the original publication.
          Never render copyrighted body text.
        -->
        <a
          href={originalUrl}
          target="_blank"
          rel="noopener noreferrer"          
          class="
            shrink-0
            border
            border-ink/15
            bg-linen
            px-4
            py-2
            font-secret-service
            font-light
            text-sm
            text-ink
            transition
            hover:border-prussian/30
            hover:bg-(--ink) 
            hover:text-(--cream)
          "
          style="
            background-image:
            /* light catches the opposite corner */
            radial-gradient(circle at 82% 80%, rgba(192,57,43,.14), transparent 60%),
            /* grain runs opposite way */
            linear-gradient(to top, rgba(28,18,8,.06), rgba(28,18,8,.12)),
            repeating-linear-gradient(
              45deg,
              rgba(28,18,8,.10) 0 1px,
              transparent 1px 11px
            );
             background-color: #f5ede0;  /* keeps it readable */

            /* tiny touches that make it sing */
            border: 1px solid rgba(28,18,8,.15);
            padding: 6px 12px;
            color: var(--ink);
            font-size: 1rem;
            letter-spacing: 0.05em;
            box-shadow: 0 1px 0 rgba(255,255,255,.5) inset;  /* subtle paper highlight */
            "
          >
          read
          <span class="text-brick"> ↗ </span>
        </a>
      </div>

    <!-- JOURNAL + OUTBOUND LINK -->
      <div
        class="
         kopani-card-top-labels
          absolute
          left-4 
          top-14 
          z-10
          flex-col
          gap-2
        "
        >
          <a
            href={journalUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="
              text-linen      
              transition 
              hover:text-ochre   
              inline-block
              font-arno
              text-xl
              italic
            "
          >
            {journalName}
          </a>

      </div>


    <!--
      TITLE AREA

      IMPORTANT:
      Adjust bottom-* to move the title higher/lower.

      Example experiments:
      bottom-10
      bottom-12
      bottom-14
      bottom-16
    -->
    <div class="kopani-card-title-wrap absolute bottom-14 left-4 right-4 z-10 md:bottom-10">      <!-- /*
          IMPORTANT TITLE LINE SPACING CONTROL

          Change leading-[X] to experiment with wrapped-line spacing.

          Examples:
          leading-[0.88]
          leading-[0.95]
          leading-[1]
          leading-[1.08]

          This is the MOST important parameter
          for the visual feel of the title.
        */ -->
      <h2
        class="
          font-display
          text-4xl
          font-normal
          text-linen
          md:text-3xl
        "
        style="line-height: 1.6;"
      >
        <a href={href}>
          <!--
            box-decoration-clone:
            Creates the editorial trailing background effect.

            Each wrapped line gets its own background box.
          -->
          <span
            class="
              inline
              bg-ink/62
              px-2
              py-1
              font-card-title
              box-decoration-clone
            "
          >
            {title}
          </span>
        </a>
      </h2>

      {
        subtitle && (
          <p
            class="
              mt-4
              max-w-[32ch]
              bg-brick/80
              px-2
              py-1
              text-base
              italic
              text-linen/90
              font-card-subtitle
              box-decoration-clone
            "
          >
            {subtitle}
          </p>
        )
      }
    </div>
  </div>

  <!--
    LOWER INFORMATION AREA

    IMPORTANT:
    Kopani NEVER displays article bodies.

    This area is ONLY:
    - metadata
    - editorial summary
    - contributor information
    - outbound links
  -->
  <div
    class="
      flex
      h-1/2
      flex-col
      p-5
      gap-4
      md:p-6
    "
    style="mask-image: linear-gradient(to bottom, black 82%, transparent 100%);"
  >
    <div>
      

      <!-- EDITORIAL SUMMARY / DEK -->
      {
        dek && (
          <p
            class="
              mt-4
              text-lg
              leading-relaxed
              text-umber
              not-italic
              font-arno
              line-clamp-4
            "
          >
            {dek}
          </p>
        )
      }
      
      <!-- META STRIP -->
      {
        metaItems.length > 0 && (
          <div
            class="
              mt-5
              flex
              md:gap-x-1
              gap-y-1
              border-t
              border-ink/10
              pt-4
              font-mono
              text-[11px]
              text-earth-bron
            "
          >
            {
              metaItems.map((item) => (
                <span class="after:content-['·'] after:ml-2 last:after:content-none">{item}</span>
              ))
            }

            {
              wordCountLabel && (
                <span>{wordCountLabel}</span>
              )
            }

            {
                readTimeMinutes && (
                  useReadTimeGauge ? (
                    <span class="after:content-['·'] after:ml-2 last:after:content-none">
                      <span class="kopani-card-gauge">
                        <span class="kopani-card-gauge__label">read</span>

                        <span class="kopani-card-gauge__track">
                          <span
                            class="kopani-card-gauge__fill"
                            style={`width: ${readTimeGaugePercent}%;`}
                          />
                          <span
                            class="kopani-card-gauge__dot"
                            style={`left: ${readTimeGaugePercent}%;`}
                          />
                        </span>

                        <span class="kopani-card-gauge__value">
                          {readTimeGaugeLabel}
                        </span>
                      </span>
                    </span>
                  ) : (
                    <span class="before:content-['·'] after:ml-2 last:after:content-none">
                      {readTimeMinutes} min read
                    </span>
                  )
                )
            }


          </div>
        )
      }
    </div>

    <!-- FOOTER CONTRIBUTORS + JOURNAL -->
    <div class="mt-1 space-y-1 border-t border-ink/10 pt-4">
      <!-- AUTHORS -->
      <div class="font-arno flex gap-2">
        <p class="text-sm text-ink/85">
          <span class="text-ink/50">By</span>
          {" "}
          {byline}
        </p>

        <!-- TRANSLATORS -->
        {
          translators.length > 0 && (
            <p class=" text-sm text-ink/85">
              <span class="text-ink/50"> trans. </span>
              {" "}
              {translators.map((t) => t.name).join(", ")}
            </p>
          )
        }

        <!-- VISUAL ARTISTS -->
        {
          visualArtists.length > 0 && (
            <p class=" font-body text-sm text-ink/85">
              <span class="text-ink/50">Visual art by</span>
              {" "}
              {visualArtists.map((v) => v.name).join(", ")}
            </p>
          )
        }
      </div>

      <!-- JOURNAL + OUTBOUND LINK -->
      <div
        class="
          flex
          items-center
          justify-between
          gap-4
        "
      >
    
      <!-- OPTIONAL AI / EDITORIAL KEYWORDS -->
      {
        visibleKeywords.length > 0 && (
          <div class="flex flex-wrap gap-2 pt-2">
            {
              visibleKeywords.map((keyword) => (
                <span
                  class="
                    border
                    border-ink/10
                    px-2
                    py-1
                    font-secret-service
                    text-[0.85rem]
                    text-ink/55
                  "
                >
                  {keyword}
                </span>
              ))
            }
          </div>
        )
      }
    </div>
  </div>
</article>
