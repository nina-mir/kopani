---
interface Props {
  kicker: string;          // "Essay" | "Fiction" | "Poetry" | ...
  headline: string;
  dek?: string;
  author: string;
  source: string;          // "The Paris Review"
  sourceUrl: string;       // outbound link
  image?: string;          // optional; falls back to hatched placeholder
  href?: string;           // internal link to article page
}

const {
  kicker, headline, dek, author, source, sourceUrl, image, href = sourceUrl,
} = Astro.props;
---

<article class="flex flex-col gap-3 pb-6">
  <!-- Image or hatched placeholder -->
  <a href={href} class="block">
    <div
      class="aspect-[4/3] w-full"
      style={image
        ? `background-image: url(${image}); background-size: cover; background-position: center;`
        : `background-image: repeating-linear-gradient(45deg, var(--color-cream-dark) 0 2px, var(--color-linen) 2px 10px);`}
      role="img"
      aria-label={image ? headline : "Editorial placeholder"}
    ></div>
  </a>

  <!-- Kicker with trailing rule -->
  <p class="font-body text-xs uppercase tracking-[0.2em] text-brick
            after:ml-3 after:inline-block after:h-px after:w-8 after:bg-brick after:align-middle">
    {kicker}
  </p>

  <!-- Headline -->
  <h2 class="font-display text-2xl font-normal leading-tight text-ink text-pretty md:text-3xl">
    <a href={href} class="transition-colors hover:text-prussian">{headline}</a>
  </h2>

  <!-- Dek -->
  {dek && (
    <p class="font-body text-base italic leading-relaxed text-umber text-pretty">
      {dek}
    </p>
  )}

  <!-- Byline + outbound source -->
  <div class="mt-auto flex flex-col gap-1 font-body text-sm">
    <span class="text-ink/80">by {author}</span>
    
      href={sourceUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="text-ochre transition-colors hover:text-prussian before:mr-1 before:content-['↗']"
    >
      {source}
    </a>
  </div>
</article>