---
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/Card.astro";

// Placeholder data until your scraper lands
const stories = [
  {
    kicker: "Essay",
    headline: "Against the Tyranny of the Clean Sentence",
    dek: "On Bernhard, repetition, and the long breath of disquiet.",
    author: "M. Halberstam",
    source: "The Paris Review",
    sourceUrl: "https://www.theparisreview.org",
  },
  // ...
];
---

<BaseLayout title="Kopani — The independent literary press, gathered.">
  <section class="grid grid-cols-1 gap-8 px-4 py-10 md:grid-cols-2 md:px-10 lg:grid-cols-4">
    {stories.map((s) => <Card {...s} />)}
  </section>
</BaseLayout>