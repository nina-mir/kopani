---
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/Card.improved.astro";
import { getRandomPieceCards } from "../lib/db";

const pieces = getRandomPieceCards(50);
---

<BaseLayout title="Kopani — The independent literary press, gathered.">
  <!-- Editorial intro -->
  <section class="border-b border-cream-dark/60 px-4 py-10 md:px-10">
    <div class="max-w-3xl">
      <p class="font-body text-xs uppercase tracking-[0.24em] text-brick">
        Recently Gathered
      </p>
      <h1 class="mt-4 font-display text-5xl leading-none font-light text-ink md:text-7xl">
        Independent literary publishing,
        <span class="italic text-ochre">carefully collected.</span>
      </h1>
      <p class="mt-6 max-w-2xl font-arno text-lg leading-relaxed text-umber">
        Kopani gathers essays, fiction, poetry, interviews, translations,
        and visual work from the independent literary press into one
        quiet reading space.
      </p>
    </div>
  </section>

  <!-- Card grid -->
  <section class="px-4 py-10 md:px-10 md:py-14">
    <div class="grid grid-cols-1 gap-x-8 gap-y-14 md:grid-cols-2 xl:grid-cols-3">
      <!-- {pieces.map((piece) => <Card piece={piece} />)} -->
      {pieces.map((piece, index) => <Card piece={piece} index={index} />)}
    </div>
  </section>
</BaseLayout>