---
// src/pages/support.astro
import BaseLayout from "../layouts/BaseLayout.astro";

const supportTiers = [
  {
    amount: "$25",
    title: "Dedicate a reading",
    body: "Mark a piece as meaningful: for a class, a friend, a teacher, a memory, or a first encounter with a writer's work.",
  },
  {
    amount: "$100",
    title: "Support the writer",
    body: "Send direct support toward the person who made the piece possible: writer, translator, visual artist, or approved journal recipient.",
  },
  {
    amount: "$250",
    title: "Sponsor a discussion",
    body: "Help a piece travel into a classroom, reading group, library program, or community conversation.",
  },
  {
    amount: "$1,000+",
    title: "Fund a collection",
    body: "Underwrite a campus reading list, alumni collection, journal pathway, or literary micro-grant around a theme or community.",
  },
];

const principles = [
  {
    n: "01",
    title: "Readers already form attachments",
    body: "People remember the essay that found them at the right time, the poem they send to a friend, the story that becomes part of a class. Kopani gives those attachments a thoughtful place to live.",
  },
  {
    n: "02",
    title: "Creators should share in the value",
    body: "Independent literary work creates cultural value long after publication. Kopani is designed so attention can become support, not just traffic.",
  },
  {
    n: "03",
    title: "Journals remain central",
    body: "Kopani does not replace literary journals. We send readers back to the original publication and build discovery, metadata, and future compensation tools around that source.",
  },
];

const flow = [
  "A reader discovers a piece through Kopani search, a campus list, or a journal pathway.",
  "They save, share, assign, or dedicate support to the work.",
  "Kopani verifies the writer, translator, artist, or rights-approved recipient before any payout.",
  "Support signals become part of the literary graph: what is being read, taught, saved, loved, and funded.",
];

const ctas = [
  {
    href: "/search",
    kicker: "Discover",
    title: "Search the index",
    body: "Find pieces by title, journal, contributor, genre, keyword, and reading time.",
    action: "Search Kopani",
  },
  {
    href: "/campuses",
    kicker: "Institutions",
    title: "Build campus reading centers",
    body: "Help students, faculty, libraries, and alumni discover contemporary literary work.",
    action: "For campuses",
  },
  {
    href: "/",
    kicker: "Browse",
    title: "Return to the gathering",
    body: "Wander through essays, fiction, poetry, interviews, translations, and visual work.",
    action: "Back home",
  },
];
---

<BaseLayout
  title="Support Writers — Kopani"
  description="Kopani is building rights-respecting patronage rails for independent literary publishing."
>
  <!-- ════════ Hero ════════ -->
  <section class="border-b-2 border-ink px-4 py-14 md:px-10 md:py-24">
    <div class="grid gap-12 lg:grid-cols-3 lg:items-end">
      <div class="reveal max-w-4xl lg:col-span-2">
        <p class="font-body text-xs uppercase tracking-[0.24em] text-brick">
          <span class="text-ochre">✶</span>&nbsp;&nbsp;Support a Writer
        </p>

        <h1 class="hero-title mt-5 font-display font-light text-ink">
          Let literary attention become
          <span class="italic text-ochre">real support.</span>
        </h1>

        <p class="mt-9 max-w-2xl font-arno text-xl leading-relaxed text-umber md:text-2xl">
          Kopani is building a rights-respecting way for readers, alumni,
          donors, and institutions to support the writers, translators,
          visual artists, and journals behind independent literature.
        </p>
      </div>

      <!-- pinned MVP note — a genuine paper artifact: tape, tilt, layered shadow -->
      <aside
        class="pinned reveal relative border border-ink/15 bg-linen/80 p-7"
        style="--reveal-delay:160ms"
      >
        <span class="pinned-tape font-mono font-semibold text-[0.65rem] uppercase tracking-[0.18em] text-umber">
           <span class="text-brick">⁂</span> editor's note
        </span>
        <p class="font-body text-xs uppercase tracking-[0.22em] text-brick">
          MVP status
        </p>
        <p class="mt-4 font-arno text-lg leading-relaxed text-ink">
          Payments are not live in this prototype. This page sketches the
          future patronage layer: verified recipients, journal-aware routing,
          and a simple principle — most of the money should go to the people
          and publications that made the work possible.
        </p>
      </aside>
    </div>
  </section>

  <!-- ════════ Principles — broadsheet columns, no boxes ════════ -->
  <section class="border-b border-cream-dark/60 px-4 py-14 md:px-10 md:py-24">
    <div class="reveal max-w-3xl">
      <p class="font-body text-xs uppercase tracking-[0.24em] text-brick">
        Why this matters
      </p>
      <h2 class="section-title mt-3 font-display font-light text-ink">
        The independent literary press creates more value than the
        current system <span class="italic text-ochre">returns.</span>
      </h2>
    </div>

    <div class="mt-14 grid gap-10 md:grid-cols-3 md:gap-8">
      {
        principles.map((item, index) => (
          <article
            class="reveal group border-t-2 border-ink pt-5"
            style={`--reveal-delay:${index * 110}ms`}
          >
            <p class="ghost-num font-display font-light">
              {item.n}
            </p>
            <h3 class="mt-4 font-display text-2xl font-light leading-tight text-ink">
              {item.title}
            </h3>
            <p class="mt-3 font-body text-sm leading-relaxed text-umber">
              {item.body}
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- ════════ Patronage model + split bar ════════ -->
  <section class="border-b border-cream-dark/60 px-4 py-14 md:px-10 md:py-24">
    <div class="grid gap-12 lg:grid-cols-5 lg:items-start">
      <div class="reveal lg:col-span-2">
        <p class="font-body text-xs uppercase tracking-[0.24em] text-brick">
          A future support model
        </p>
        <h2 class="section-title mt-3 font-display font-light text-ink">
          Dedications, micro-grants, and reader-backed literary support.
        </h2>
        <p class="mt-9 font-arno text-xl leading-relaxed text-umber">
          A reader should be able to say: this piece mattered to me. A campus
          should be able to say: this writer belongs in our classroom. A patron
          should be able to support the specific work they love — without
          pulling the reader away from the original journal.
        </p>

        <!-- the 90/10 split, made visible and animated -->
        <div class="split reveal mt-10">
          <p class="font-body text-xs uppercase tracking-[0.22em] text-ochre">
            Proposed split · future verified payments
          </p>
          <div class="mt-4 flex h-4 w-full overflow-hidden border border-ink/25">
            <div class="split-fill bg-brick/85" style="--w:90%"></div>
            <div class="split-fill bg-prussian/85" style="--w:10%"></div>
          </div>
          <div class="mt-3.5 flex items-baseline justify-between gap-6 font-body text-sm text-umber">
            <span class="whitespace-nowrap"
              ><strong class="font-display text-xl text-ink">90%</strong> to creators</span
            >
            <span class="whitespace-nowrap text-right"
              ><strong class="font-display text-xl text-ink">10%</strong> to Kopani</span
            >
          </div>
          <p class="mt-4 font-body text-xs leading-relaxed text-umber/80">
            Kopani's share covers discovery, infrastructure, verification, and routing.
          </p>
        </div>
      </div>

      <!-- support tiers — de-boxed, amount-led, hover lifts the rule to brick -->
      <div class="grid gap-x-8 gap-y-9 sm:grid-cols-2 lg:col-span-3">
        {
          supportTiers.map((tier, index) => (
            <article
              class="tier reveal group border-t-2 border-ink pt-5"
              style={`--reveal-delay:${index * 90}ms`}
            >
              <div class="flex items-baseline justify-between">
                <p class="tier-amount font-display font-light text-brick">
                  {tier.amount}
                </p>
                <span class="font-mono text-[0.65rem] uppercase tracking-[0.18em] text-cream-dark transition-colors group-hover:text-ochre">
                  Tier
                </span>
              </div>
              <h3 class="mt-4 font-display text-2xl font-light leading-tight text-ink">
                {tier.title}
              </h3>
              <p class="mt-3 font-body text-sm leading-relaxed text-umber">
                {tier.body}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ════════ How it works — numbered ledger ════════ -->
  <section class="border-b border-cream-dark/60 px-4 py-14 md:px-10 md:py-24">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-start">
      <div class="reveal lg:sticky lg:top-10">
        <p class="font-body text-xs uppercase tracking-[0.24em] text-brick">
          How support becomes infrastructure
        </p>
        <h2 class="section-title mt-3 font-display font-light text-ink">
          Discovery, community, and compensation can
          <span class="italic text-ochre">reinforce one another.</span>
        </h2>
      </div>

      <ol class="border-t-2 border-ink">
        {
          flow.map((step, index) => (
            <li
              class="ledger-row reveal flex items-baseline gap-5 border-b border-cream-dark py-6 last:border-b-0"
              style={`--reveal-delay:${index * 90}ms`}
            >
              <span class="ledger-num w-14 shrink-0 font-display font-light text-ochre">
                {String(index + 1).padStart(2, "0")}
              </span>
              <p class="font-arno text-lg leading-relaxed text-umber">
                {step}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ════════ Community pull-quote ════════ -->
  <section class="border-b border-cream-dark/60 bg-cream/35 px-4 py-20 md:px-10 md:py-28">
    <div class="reveal mx-auto max-w-4xl text-center">
      <p class="quote-mark font-display leading-none text-brick/25" aria-hidden="true">“</p>
      <blockquote class="pull-quote mt-2 font-display font-light text-ink">
        A literary graph should not only measure what gets attention.
        It should help <span class="italic text-ochre">care travel back</span>
        to the people who made the work.
      </blockquote>
      <div class="mx-auto mt-10 h-px w-16 bg-cream-dark"></div>
      <p class="mx-auto mt-8 max-w-2xl font-arno text-xl leading-relaxed text-umber">
        Kopani begins with search and reading lists. Over time, the same signals
        can reveal what readers save, what faculty assign, what journals publish,
        what alumni gather around, and which creators communities choose to support.
      </p>
    </div>
  </section>

  <!-- ════════ CTAs — hairline cards, animated arrows ════════ -->
  <section class="px-4 py-14 md:px-10 md:py-24">
    <div class="grid gap-x-8 gap-y-10 md:grid-cols-3">
      {
        ctas.map((cta, index) => (
          <a
            href={cta.href}
            class="cta reveal group border-t-2 border-ink pt-5"
            style={`--reveal-delay:${index * 90}ms`}
          >
            <p class="font-body text-xs uppercase tracking-[0.22em] text-brick">
              {cta.kicker}
            </p>
            <h3 class="mt-4 font-display text-3xl font-light leading-tight text-ink">
              {cta.title}
            </h3>
            <p class="mt-3 font-body text-sm leading-relaxed text-umber">
              {cta.body}
            </p>
            <p class="mt-6 flex items-center gap-2 font-body text-xs uppercase tracking-[0.2em] text-ochre transition-colors group-hover:text-brick">
              {cta.action}
              <span class="cta-arrow transition-transform">&rarr;</span>
            </p>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Display type scale, set explicitly so the hierarchy can't be ──
       flattened by a prose reset or a missing Tailwind size token.
       Scoped selectors outrank utility classes, so these always win. */
  .hero-title {
    font-size: clamp(2.75rem, 6.5vw, 5.5rem);
    line-height: 1.04;
    letter-spacing: -0.01em;
    font-weight: 400;
  }
  .section-title {
    font-size: clamp(2.25rem, 4.6vw, 3.6rem);
    line-height: 1.1;
    font-weight: 400;
  }
  .ghost-num {
    font-size: clamp(5rem, 9vw, 8rem);
    line-height: 0.9;
    font-weight: 300; /* the one intentionally light, pale accent */
  }
  .tier-amount {
    font-size: clamp(3.25rem, 4.6vw, 4.25rem);
    line-height: 1;
    font-weight: 400;
  }
  .ledger-num {
    font-size: clamp(2.75rem, 3.6vw, 3.5rem);
    line-height: 0.95;
    font-weight: 400;
  }
  .pull-quote {
    font-size: clamp(2.25rem, 5.4vw, 4.25rem);
    line-height: 1.16;
    font-weight: 400;
  }

  /* ── Reveal-on-scroll: fade + rise, staggered per element ─────────── */
  .reveal {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--reveal-delay, 0ms);
    will-change: opacity, transform;
  }
  .reveal.is-visible {
    opacity: 1;
    transform: none;
  }

  /* ── Pinned note: a real paper artifact ───────────────────────────── */
  .pinned {
    transform: rotate(-0.5deg);
    background-image: repeating-linear-gradient(
      135deg,
      rgba(28, 18, 8, 0.022) 0 1px,
      transparent 1px 14px
    );
    box-shadow:
      6px 8px 0 rgba(28, 18, 8, 0.045),
      0 20px 34px -22px rgba(28, 18, 8, 0.4);
  }
  .pinned-tape {
    position: absolute;
    top: -0.75rem;
    left: 1.75rem;
    transform: rotate(-2.2deg);
    padding: 0.25rem 0.75rem;
    background: var(--color-linen, #f4ece0);
    border: 1px solid rgba(28, 18, 8, 0.22);
    box-shadow: 0 1px 2px rgba(28, 18, 8, 0.12);
  }

  /* ── Ghost numerals in the principles columns ─────────────────────── */
  .ghost-num {
    color: var(--color-cream-dark, #d6c9ad);
    transition: color 0.45s ease;
  }
  .group:hover .ghost-num {
    color: var(--color-ochre, #9a7b1f);
  }

  /* ── Support tiers: subtle lift + warm rule on hover ──────────────── */
  .tier {
    transition:
      border-color 0.3s ease,
      transform 0.3s ease;
  }
  .tier:hover {
    border-color: var(--color-brick, #c0392b);
    transform: translateY(-3px);
  }

  /* ── 90 / 10 split bar grows on reveal ────────────────────────────── */
  .split-fill {
    width: 0;
    transition: width 1.1s cubic-bezier(0.22, 1, 0.36, 1) 0.25s;
  }
  .split.is-visible .split-fill {
    width: var(--w);
  }

  /* ── Ledger rows: number warms, text nudges in on hover ───────────── */
  .ledger-row {
    transition: border-color 0.3s ease;
  }
  .ledger-num {
    transition:
      color 0.3s ease,
      transform 0.3s ease;
  }
  .ledger-row:hover {
    border-color: var(--color-ochre, #9a7b1f);
  }
  .ledger-row:hover .ledger-num {
    color: var(--color-brick, #c0392b);
    transform: translateX(2px);
  }

  /* ── Pull-quote mark, sized and spaced so it never collides ───────── */
  .quote-mark {
    font-size: clamp(4rem, 9vw, 6.5rem);
    margin-bottom: -0.35em;
  }

  /* ── CTA hover ────────────────────────────────────────────────────── */
  .cta {
    transition: border-color 0.3s ease;
  }
  .cta:hover {
    border-color: var(--color-brick, #c0392b);
  }
  .cta:hover .cta-arrow {
    transform: translateX(5px);
  }

  /* ── Respect reduced-motion: show everything, animate nothing ─────── */
  @media (prefers-reduced-motion: reduce) {
    .reveal,
    .reveal.is-visible {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .split-fill {
      width: var(--w);
      transition: none;
    }
    .tier,
    .ledger-num,
    .cta-arrow {
      transition: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const reveals = Array.from(document.querySelectorAll(".reveal"));
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (reduce || !("IntersectionObserver" in window)) {
      reveals.forEach((el) => el.classList.add("is-visible"));
      return;
    }

    const io = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
    );

    reveals.forEach((el) => io.observe(el));
  })();
</script>