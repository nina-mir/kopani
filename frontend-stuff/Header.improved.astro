---
const navItems = [
  { label: "Essays", href: "/essays" },
  { label: "Fiction", href: "/fiction" },
  { label: "Poetry", href: "/poetry" },
  { label: "Interviews", href: "/interviews" },
  { label: "Art", href: "/art" },
];

const utilityItems = [
  { label: "For Campuses", href: "/campuses" },
  { label: "Support a Writer", href: "/support" },
];
---

<div
  id="site-header"
  class="sticky top-0 z-30 border-b-[3px] border-double border-ink bg-cream/95 backdrop-blur supports-[backdrop-filter]:bg-cream/85"
>
  <header>
    <div
      class="grid grid-cols-[44px_1fr_44px] items-center px-4 py-4 md:grid-cols-[1fr_auto_1fr] md:px-10 md:py-6"
      data-header-inner
    >
      <!-- Left: hamburger.
           Mobile: always visible.
           Desktop: hidden at top, visible after scroll.
      -->
      <div class="justify-self-start self-center">
        <button
          id="nav-toggle"
          aria-label="Open menu"
          aria-expanded="false"
          class="flex flex-col gap-1.5 p-2 opacity-100 transition-opacity duration-200 md:pointer-events-none md:opacity-0"
          data-header-toggle
        >
          <span class="block h-[2px] w-[22px] bg-ink/80"></span>
          <span class="block h-[2px] w-[22px] bg-ink/75"></span>
          <span class="block h-[2px] w-[22px] bg-ink/70"></span>
        </button>
      </div>

      <!-- Center: logo -->
      <a href="/" class="min-w-0 justify-self-center text-center">
        <h1
          class="font-secret-service leading-none tracking-tight text-ink/90"
          data-header-logo
        >
          Kopani
        </h1>

        <!-- Desktop subtitle -->
        <p
          class="mt-2 hidden font-arno italic font-normal text-ochre md:block md:text-[1rem] md:tracking-[0.06em]"
          data-header-byline
        >
          The independent literary press, gathered.
        </p>
      </a>

      <!-- Right: desktop search, mobile spacer -->
      <div class="justify-self-end self-center">
        <div class="w-[44px] md:hidden" data-header-mobile-spacer></div>

        <form
          action="/search"
          method="get"
          role="search"
          class="hidden w-[260px] md:block lg:w-[320px]"
          data-header-search
        >
          <label for="global-search-desktop" class="sr-only">
            Search Kopani
          </label>

          <div
            class="flex items-center border border-ink/20 bg-linen/70 shadow-[2px_2px_0_rgba(28,18,8,0.08)] transition focus-within:border-prussian focus-within:shadow-[2px_2px_0_rgba(44,62,107,0.18)]"
          >
            <input
              id="global-search-desktop"
              name="q"
              type="search"
              autocomplete="off"
              placeholder="Search Kopani"
              class="min-w-0 flex-1 bg-transparent px-3 py-2 font-body text-sm text-ink outline-none placeholder:italic placeholder:text-umber/45"
            />

            <button
              type="submit"
              aria-label="Search"
              class="self-stretch border-l border-ink/15 px-3 font-mono text-umber transition hover:bg-ink hover:text-linen"
            >
              ↗
            </button>
          </div>
        </form>
      </div>

      <!-- Mobile subtitle -->
      <p
        class="col-span-3 mt-2 whitespace-nowrap text-center font-arno text-[1rem] font-normal italic text-ochre md:hidden"
        data-header-mobile-byline
      >
        The independent literary press, gathered.
      </p>
    </div>
  </header>

  <!-- Primary nav.
       Desktop only at top.
       Hidden once the header condenses.
  -->
  <nav
    class="hidden border-t border-cream-dark py-3 md:block"
    data-primary-nav
  >
    <ul
      class="flex justify-center font-body text-sm uppercase tracking-[0.18em] text-ink"
    >
      {
        navItems.map((item, i) => (
          <li class="flex items-center">
            <a href={item.href} class="px-4 hover:text-prussian">
              {item.label}
            </a>
            {i < navItems.length - 1 && <span class="text-cream-dark">|</span>}
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<!-- Drawer backdrop: works on mobile AND desktop -->
<div
  id="nav-backdrop"
  class="fixed inset-0 z-40 hidden"
  style="background-color: rgba(28, 18, 8, 0.55);"
  aria-hidden="true"
>
</div>

<!-- Drawer: works on mobile AND desktop -->
<aside
  id="nav-drawer"
  class="fixed left-0 top-0 z-50 h-full w-[85vw] max-w-[360px] -translate-x-full bg-linen p-6 transition-transform duration-300 ease-out"
  aria-label="Site navigation"
>
  <div class="flex items-start justify-between border-b-2 border-umber pb-4">
    <span class="font-secret-service text-3xl leading-none text-ink/90">
      Kopani
    </span>

    <button
      id="nav-close"
      aria-label="Close menu"
      class="font-display text-3xl leading-none text-ink"
    >
      ×
    </button>
  </div>

  <form action="/search" method="get" role="search" class="mt-6">
    <label
      for="global-search-mobile"
      class="block font-body text-xs uppercase tracking-[0.2em] text-brick"
    >
      Search Kopani
    </label>

    <div
      class="mt-3 flex items-center border border-ink/20 bg-linen/80 shadow-[2px_2px_0_rgba(28,18,8,0.08)] transition focus-within:border-prussian focus-within:shadow-[2px_2px_0_rgba(44,62,107,0.18)]"
    >
      <input
        id="global-search-mobile"
        name="q"
        type="search"
        autocomplete="off"
        placeholder="Title, author, journal..."
        class="min-w-0 flex-1 bg-transparent px-3 py-3 font-body text-base text-ink outline-none placeholder:italic placeholder:text-umber/45"
      />

      <button
        type="submit"
        aria-label="Search"
        class="self-stretch border-l border-ink/15 px-4 font-mono text-base text-umber transition hover:bg-ink hover:text-linen"
      >
        ↗
      </button>
    </div>
  </form>

  <p class="mt-8 font-body text-xs uppercase tracking-[0.2em] text-brick">
    Browse
  </p>

  <ul class="mt-4 space-y-3 font-display text-2xl font-light">
    {
      navItems.map((item) => (
        <li>
          <a href={item.href} class="block text-ink hover:text-prussian">
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>

  <p class="mt-8 font-body text-xs uppercase tracking-[0.2em] text-brick">
    Kopani
  </p>

  <ul class="mt-4 space-y-3 font-display text-2xl font-light">
    {
      utilityItems.map((item) => (
        <li>
          <a href={item.href} class="block text-ink hover:text-prussian">
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>

  <p
    class="absolute bottom-6 left-6 right-6 font-body text-sm italic text-umber"
  >
    Read what the small presses are printing.
  </p>
</aside>

<script>
  const siteHeader = document.getElementById("site-header");
  const toggle = document.getElementById("nav-toggle");
  const drawer = document.getElementById("nav-drawer");
  const backdrop = document.getElementById("nav-backdrop");
  const closeBtn = document.getElementById("nav-close");

  const open = () => {
    drawer?.classList.remove("-translate-x-full");
    backdrop?.classList.remove("hidden");
    toggle?.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
  };

  const close = () => {
    drawer?.classList.add("-translate-x-full");
    backdrop?.classList.add("hidden");
    toggle?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  };

  /**
   * Stable folding trigger.
   *
   * The header folds only after the reader has clearly started scrolling.
   * It unfolds only when the reader returns close to the top.
   * This two-threshold setup prevents oscillation caused by the header's
   * own height changing during the transition.
   */
  const CONDENSE_AT = 120;
  const EXPAND_AT = 24;

  let isCondensed = false;
  let isTicking = false;

  const setCondensed = (nextValue) => {
    if (isCondensed === nextValue) return;

    isCondensed = nextValue;
    siteHeader?.classList.toggle("is-condensed", isCondensed);
  };

  const evaluateHeaderState = () => {
    const scrollY = window.scrollY;

    if (!isCondensed && scrollY > CONDENSE_AT) {
      setCondensed(true);
    } else if (isCondensed && scrollY < EXPAND_AT) {
      setCondensed(false);
    }

    isTicking = false;
  };

  const onScroll = () => {
    if (isTicking) return;

    isTicking = true;
    window.requestAnimationFrame(evaluateHeaderState);
  };

  toggle?.addEventListener("click", open);
  closeBtn?.addEventListener("click", close);
  backdrop?.addEventListener("click", close);

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") close();
  });

  evaluateHeaderState();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>

<style>
  /*
    Sticky folded header behavior.

    At the top:
    - big literary masthead
    - byline visible
    - desktop primary nav visible

    After scroll:
    - compact app-like header
    - desktop hamburger appears
    - bylines disappear
    - desktop nav folds away
  */

  #site-header {
    transform-origin: top center;
  }

  #site-header [data-header-inner] {
    transition:
      padding 260ms ease,
      transform 260ms ease;
  }

  #site-header [data-header-logo] {
    font-size: clamp(2.75rem, 7vw, 5rem);
    transition:
      font-size 260ms ease,
      transform 260ms ease;
  }

  #site-header [data-header-toggle] {
    transition:
      opacity 180ms ease,
      transform 220ms ease;
  }

  #site-header [data-header-search] {
    transition:
      opacity 180ms ease,
      transform 220ms ease;
  }

  #site-header [data-header-byline],
  #site-header [data-header-mobile-byline],
  #site-header [data-primary-nav] {
    max-height: 80px;
    opacity: 1;
    overflow: hidden;
    transition:
      opacity 180ms ease,
      max-height 260ms ease,
      margin 260ms ease,
      padding 260ms ease;
  }

  #site-header.is-condensed [data-header-inner] {
    padding-top: 0.55rem;
    padding-bottom: 0.55rem;
  }

  #site-header.is-condensed [data-header-logo] {
    font-size: clamp(2rem, 4vw, 2.65rem);
    transform: translateY(-1px);
  }

  #site-header.is-condensed [data-header-byline],
  #site-header.is-condensed [data-header-mobile-byline],
  #site-header.is-condensed [data-primary-nav] {
    max-height: 0;
    margin-top: 0;
    padding-top: 0;
    padding-bottom: 0;
    opacity: 0;
    pointer-events: none;
  }

  @media (min-width: 768px) {
    #site-header.is-condensed [data-header-toggle] {
      pointer-events: auto;
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 767px) {
    #site-header.is-condensed [data-header-inner] {
      grid-template-columns: 44px 1fr 44px;
    }

    #site-header.is-condensed [data-header-logo] {
      font-size: 2.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #site-header [data-header-inner],
    #site-header [data-header-logo],
    #site-header [data-header-toggle],
    #site-header [data-header-search],
    #site-header [data-header-byline],
    #site-header [data-header-mobile-byline],
    #site-header [data-primary-nav],
    #nav-drawer {
      transition: none;
    }
  }
</style>
